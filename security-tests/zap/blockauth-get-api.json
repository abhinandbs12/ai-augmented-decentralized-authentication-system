{
  "openapi": "3.0.3",
  "info": { "title": "BlockAuth read endpoints, for ZAP API scans of a local stack", "version": "1" },
  "servers": [{ "url": "http://host.docker.internal:3000" }],
  "components": {
    "parameters": {
      "page": { "name": "page", "in": "query", "schema": { "type": "integer", "example": 0 } },
      "size": { "name": "size", "in": "query", "schema": { "type": "integer", "example": 20 } },
      "wallet": { "name": "walletAddress", "in": "query", "schema": { "type": "string", "example": "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC" } },
      "from": { "name": "from", "in": "query", "schema": { "type": "string", "example": "2026-01-01T00:00:00Z" } },
      "to": { "name": "to", "in": "query", "schema": { "type": "string", "example": "2027-01-01T00:00:00Z" } },
      "address": { "name": "address", "in": "path", "required": true, "schema": { "type": "string", "example": "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC" } }
    }
  },
  "paths": {
    "/api/users/me": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/api/users/authentication-history": { "get": { "parameters": [{ "$ref": "#/components/parameters/page" }, { "$ref": "#/components/parameters/size" }, { "name": "eventType", "in": "query", "schema": { "type": "string", "example": "LOGIN" } }], "responses": { "200": { "description": "ok" } } } },
    "/api/users/wallet-status": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/api/users/sessions": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/api/users/devices": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/api/users/alerts": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/api/users/second-step": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/api/admin/users": { "get": { "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string", "example": "ACTIVE" } }, { "name": "role", "in": "query", "schema": { "type": "string", "example": "USER" } }, { "$ref": "#/components/parameters/wallet" }, { "$ref": "#/components/parameters/page" }, { "$ref": "#/components/parameters/size" }], "responses": { "200": { "description": "ok" } } } },
    "/api/admin/authentication-events": { "get": { "parameters": [{ "name": "eventType", "in": "query", "schema": { "type": "string", "example": "LOGIN" } }, { "name": "eventStatus", "in": "query", "schema": { "type": "string", "example": "SUCCESS" } }, { "$ref": "#/components/parameters/wallet" }, { "$ref": "#/components/parameters/from" }, { "$ref": "#/components/parameters/to" }, { "$ref": "#/components/parameters/page" }, { "$ref": "#/components/parameters/size" }], "responses": { "200": { "description": "ok" } } } },
    "/api/admin/security-events": { "get": { "parameters": [{ "name": "attackType", "in": "query", "schema": { "type": "string", "example": "REPLAY_ATTEMPT" } }, { "$ref": "#/components/parameters/wallet" }, { "$ref": "#/components/parameters/from" }, { "$ref": "#/components/parameters/to" }, { "$ref": "#/components/parameters/page" }, { "$ref": "#/components/parameters/size" }], "responses": { "200": { "description": "ok" } } } },
    "/api/admin/statistics": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/api/admin/login-assessments": { "get": { "parameters": [{ "$ref": "#/components/parameters/wallet" }, { "name": "decision", "in": "query", "schema": { "type": "string", "example": "ALLOW" } }, { "$ref": "#/components/parameters/page" }, { "$ref": "#/components/parameters/size" }], "responses": { "200": { "description": "ok" } } } },
    "/api/admin/wallet-flags": { "get": { "parameters": [{ "$ref": "#/components/parameters/page" }, { "$ref": "#/components/parameters/size" }], "responses": { "200": { "description": "ok" } } } },
    "/api/admin/actions": { "get": { "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string", "example": "PENDING" } }, { "$ref": "#/components/parameters/page" }, { "$ref": "#/components/parameters/size" }], "responses": { "200": { "description": "ok" } } } },
    "/api/admin/api-keys": { "get": { "parameters": [{ "$ref": "#/components/parameters/page" }, { "$ref": "#/components/parameters/size" }], "responses": { "200": { "description": "ok" } } } },
    "/api/admin/emergency-stop": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/api/blockchain/wallet/{address}": { "get": { "parameters": [{ "$ref": "#/components/parameters/address" }], "responses": { "200": { "description": "ok" } } } },
    "/api/blockchain/verify/{address}": { "get": { "parameters": [{ "$ref": "#/components/parameters/address" }], "responses": { "200": { "description": "ok" } } } }
  }
}
