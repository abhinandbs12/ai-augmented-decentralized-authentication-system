# =============================================================
# Environment Variables — AI-Augmented Decentralized Auth System
# =============================================================
# Copy this file to .env and fill in the two values under REQUIRED.
# Everything else has a working default: an empty value means "use it".
# NEVER commit .env — it is git-ignored.
#
# Note on Docker: docker-compose.yml sets the service URLs, the database URLs
# and the contract address itself, and those win over anything set here. The
# variables below marked "host only" are read by the seed and scenario scripts,
# which run outside the containers.
# =============================================================

# -------------------------------------------------------------
# REQUIRED — the stack will not work without these two
# -------------------------------------------------------------

# Wallets allowed into the operations console, comma-separated.
# For the demo this is Hardhat account #0, which also deploys the contract:
#   ADMIN_WALLETS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Anything that is not a 0x-prefixed 40-character address is ignored, so a typo
# silently locks you out of the console.
ADMIN_WALLETS=

# Shared secret the orchestrator presents when it records a login event on the
# risk engine, and the credential the demo scripts use. Any long random value.
# The risk engine refuses to record anything while this is empty, and the
# orchestrator refuses to start. Generate one with:
#   openssl rand -hex 24
INTERNAL_API_TOKEN=

# -------------------------------------------------------------
# SMS delivery for the step-up code — optional
# -------------------------------------------------------------
# All three are needed before any code is sent by SMS. Leave them empty for a
# local demonstration and use OTP_DEMO_DELIVERY instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Demo only. With no SMS provider the generated code reaches nobody, so the
# step-up route cannot be finished by hand. "true" writes the code to the
# orchestrator's log so a reviewer can read it. Empty or "false" means no code
# is written anywhere, which is the default and the only safe setting outside a
# demonstration. docker-compose.dev.yml turns this on for the demo stack, so
# you do not need to set it here.
OTP_DEMO_DELIVERY=

# -------------------------------------------------------------
# Blockchain — optional for the Docker demo
# -------------------------------------------------------------
# Compose points the orchestrator at the hardhat container and hands it the
# deployed address through a shared file, so all three stay empty for the demo.
# Set them to run the orchestrator outside Docker or against another chain.
#
# ADMIN_PRIVATE_KEY is the account that signs pause, resume and Merkle-root
# transactions. Left empty, the local Hardhat node's first unlocked account is
# used, which is also the contract's admin. Any real deployment must set it.
RPC_URL=
CONTRACT_ADDRESS=
ADMIN_PRIVATE_KEY=

# -------------------------------------------------------------
# Databases — optional
# -------------------------------------------------------------
# Compose builds the orchestrator's DATABASE_URL from the three POSTGRES_
# values and defaults them to authuser / authpass / authdb for the local demo.
# Set them to use anything else. DATABASE_URL and MONGO_URL are only read when
# a service runs outside Compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
MONGO_URL=

# -------------------------------------------------------------
# Service URLs — host only, optional
# -------------------------------------------------------------
# Read by the seed and scenario scripts. The defaults below match the
# development overlay, so leave them empty unless you moved a port.
#   ORCHESTRATOR_URL  default http://localhost:3001
#   RISK_ENGINE_URL   default http://localhost:8001
ORCHESTRATOR_URL=
RISK_ENGINE_URL=

# -------------------------------------------------------------
# Tuning — all optional, empty means the documented default
# -------------------------------------------------------------
# Sessions: 30 minute tokens, 1000 cached (TRD §11.3).
SESSION_TTL_MINUTES=
SESSION_CACHE_CAPACITY=

# Login challenges: 5 minute nonces, 5 minute codes, 3 attempts, and one
# Merkle batch per 16 events or 60 seconds (TRD §5.4, §5.5, §11.2).
NONCE_TTL_MINUTES=
OTP_TTL_MINUTES=
OTP_MAX_ATTEMPTS=
MERKLE_BATCH_SIZE=
MERKLE_BATCH_MS=

# Circuit breaker: pause authentication when more than BREAKER_THRESHOLD
# attempts score below 50 within BREAKER_WINDOW_MS (defaults 50 and 10000).
BREAKER_THRESHOLD=
BREAKER_WINDOW_MS=

# Risk engine velocity rule: the -25 penalty applies at VELOCITY_THRESHOLD
# attempts from one address inside VELOCITY_WINDOW_SECONDS (defaults 5 and
# 300). Compose sets these for the containers; docker-compose.dev.yml raises
# the threshold to 10 because every client in the lab shares one address.
VELOCITY_THRESHOLD=
VELOCITY_WINDOW_SECONDS=

# Gateway rate limit: token bucket of 10, one token every 3 seconds, per client
# address (TRD §5.1).
TOKEN_BUCKET_CAPACITY=
TOKEN_BUCKET_REFILL_INTERVAL_MS=
