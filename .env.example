# BlockAuth configuration. Copy this file to ".env.local" in the repository root and fill in the blanks.
# ".env.local" is git-ignored: never commit it, and never put real values in this example file.
# The backend reads ".env.local" at startup; real environment variables override it.

# --- Neon PostgreSQL (the application's branch) ---
# JDBC URL of the direct (non-pooled) host. Form: jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_URL=
# Neon role name and its password. The password is a secret.
DB_USERNAME=
DB_PASSWORD=

# --- Neon PostgreSQL (test branch) ---
# Used only by the backend integration tests, which empty the tables before each test.
# Point these at a separate branch, never at the branch DB_URL points at.
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# --- Blockchain ---
# JSON-RPC endpoint of the chain. The local Hardhat node listens here.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Expected chain ID. The backend refuses to start if the node reports a different one.
BLOCKCHAIN_CHAIN_ID=31337
# Address printed by "npx hardhat run scripts/deploy.js --network localhost". Form: 0x + 40 hex characters.
CONTRACT_ADDRESS=
# Private key of the account that deployed the contract (Hardhat account #0 locally). The backend signs
# register/revoke/activate transactions with it. Form: 0x + 64 hex characters. This is a secret.
# Hardhat's built-in keys are public knowledge: use them only on the local node.
BLOCKCHAIN_OPERATOR_PRIVATE_KEY=

# --- Application ---
# Comma-separated wallet addresses that receive the ADMIN role when they register. Without at least one
# entry nobody can open the admin pages. These are public addresses, not keys.
BLOCKAUTH_ADMIN_WALLETS=
# Exact origin of the web app. POST requests from any other origin are rejected, and the host part is
# written into every sign-in message.
APP_ORIGIN=http://localhost:5173
# Lifetime of a sign-in message in seconds (60-600).
CHALLENGE_TTL_SECONDS=120
# How long a session may stay idle before the user must sign in again.
SESSION_TIMEOUT=30m
# Whether cookies carry the Secure flag. "false" only for http://localhost; must be "true" when deployed.
SESSION_COOKIE_SECURE=false
# Spring profile: dev, test or prod. Takes effect as a real environment variable (Docker Compose passes
# it through); a value that exists only in this file does not select a profile.
SPRING_PROFILES_ACTIVE=dev

# --- Account security ---
# Encrypts the authenticator secrets of the second step and keys the stored backup-code hashes. 32 random bytes, Base64-encoded (44 characters).
# Secret. Generate one, for example in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# or with OpenSSL: openssl rand -base64 32
SECOND_STEP_ENCRYPTION_KEY=
# Days a device stays trusted after the second step passed on it (1-365).
TRUSTED_DEVICE_DAYS=30
# Waiting period before a wallet reactivation, a second-step reset or the lifting of the emergency stop
# takes effect, as a duration such as 10m or 1h (1 second to 7 days). Any administrator can cancel during it.
ADMIN_ACTION_DELAY=10m
