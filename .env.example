# =============================================================
# Environment Variables — AI-Augmented Decentralized Auth System
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it is git-ignored.
# =============================================================

# --- Blockchain / Hardhat ---
RPC_URL=
ADMIN_PRIVATE_KEY=
CONTRACT_ADDRESS=

# --- Admin ---
ADMIN_WALLETS=

# --- Twilio (SMS OTP) ---
# All three are needed before any code is sent by SMS. Leave them empty for a
# local demonstration and use OTP_DEMO_DELIVERY below instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Demo only. With no SMS provider the generated code reaches nobody, so the
# step-up route cannot be finished by hand. "true" writes the code to the
# orchestrator's log so a reviewer can read it. Empty or "false" means no code
# is written anywhere, which is the default and the only safe setting outside a
# demonstration. docker-compose.dev.yml turns this on for the demo stack.
OTP_DEMO_DELIVERY=

# --- Internal service authentication ---
# Shared secret the orchestrator presents when it reports a login event to the
# risk engine. Any long random value; the demo scripts read the same variable.
INTERNAL_API_TOKEN=

# --- Databases ---
# The Compose stack builds DATABASE_URL from these three; they default to the
# local demo values when left empty.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
MONGO_URL=

# --- Service URLs ---
ORCHESTRATOR_URL=
RISK_ENGINE_URL=
GATEWAY_URL=

# --- n8n Automation ---
N8N_WEBHOOK_URL=

# --- Session ---
SESSION_TTL_MINUTES=
SESSION_CACHE_CAPACITY=

# --- Login challenges ---
# Empty means the documented default: 5 minute nonces, 5 minute OTP codes,
# 3 OTP attempts, and one Merkle batch per 16 events or 60 seconds.
NONCE_TTL_MINUTES=
OTP_TTL_MINUTES=
OTP_MAX_ATTEMPTS=
MERKLE_BATCH_SIZE=
MERKLE_BATCH_MS=

# Circuit breaker: pause authentication when more than BREAKER_THRESHOLD
# attempts score below 50 within BREAKER_WINDOW_MS (defaults 50 and 10000).
BREAKER_THRESHOLD=
BREAKER_WINDOW_MS=

# --- Risk Engine ---
SCORER=rules
VELOCITY_WINDOW_SECONDS=
VELOCITY_THRESHOLD=

# --- Rate Limiting ---
TOKEN_BUCKET_CAPACITY=
TOKEN_BUCKET_REFILL_INTERVAL_MS=
SLIDING_WINDOW_MAX=
SLIDING_WINDOW_INTERVAL_MS=
