# =============================================================
# Environment Variables — AI-Augmented Decentralized Auth System
# =============================================================
# Copy this file to .env and fill in section 1. Everything else already has a
# working value. NEVER commit .env — it is git-ignored.
#
# The sections are ordered by what you have to do:
#   1. You must supply these two.
#   2. Optional: only for real SMS delivery.
#   3. Already set to the documented defaults; edit to tune.
#   4. Local demo defaults; only set for a different database.
#   5. Only needed outside the Docker demo.
#   6. Reference: supplied by Compose, editing here has no effect.
# =============================================================

# -------------------------------------------------------------
# 1. REQUIRED — nothing else supplies these
# -------------------------------------------------------------

# Wallets allowed into the operations console, comma-separated. This must be
# the account that deploys the contract. With the Docker demo that is Hardhat
# account #0, the same on every machine:
#   ADMIN_WALLETS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Read it back at any time with: docker compose logs hardhat | grep "Account #0"
# Anything that is not a 0x-prefixed 40-character address is discarded without
# an error, and the console then refuses every wallet.
ADMIN_WALLETS=

# Shared secret the orchestrator presents when it records a login event on the
# risk engine, and the credential the demo scripts use. Without it the risk
# engine refuses to record anything (HTTP 503) and the orchestrator will not
# start. Invent one; there is no account to create:
#   openssl rand -hex 24
INTERNAL_API_TOKEN=

# -------------------------------------------------------------
# 2. OPTIONAL — real SMS delivery for the step-up code
# -------------------------------------------------------------
# All three are needed before a code is sent by text message. Leave them empty
# for a demonstration: docker-compose.dev.yml sets OTP_DEMO_DELIVERY=true,
# which writes the code to the orchestrator's log instead, and the code screen
# says so. A configured provider always takes priority over that.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -------------------------------------------------------------
# 3. TUNING — these values are live; edit them to change behaviour
# -------------------------------------------------------------
# Set to the documented defaults so the file shows what the system actually
# does. Clearing a line falls back to the same number in code.

# Sessions: 30 minute tokens, 1000 cached (TRD §11.3).
SESSION_TTL_MINUTES=30
SESSION_CACHE_CAPACITY=1000

# Login challenges: 5 minute nonces, 5 minute codes, 3 attempts (TRD §11.2, §5.5).
NONCE_TTL_MINUTES=5
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Audit trail: one Merkle batch per 16 events or 60 seconds (TRD §5.4).
MERKLE_BATCH_SIZE=16
MERKLE_BATCH_MS=60000

# Circuit breaker: pause authentication when more than 50 attempts score below
# 50 within 10 seconds (TRD §12.3).
BREAKER_THRESHOLD=50
BREAKER_WINDOW_MS=10000

# Gateway rate limit: a bucket of 10, one token every 3 seconds, per client
# address (TRD §5.1).
TOKEN_BUCKET_CAPACITY=10
TOKEN_BUCKET_REFILL_INTERVAL_MS=3000

# -------------------------------------------------------------
# 4. DATABASE CREDENTIALS — empty means the local demo defaults
# -------------------------------------------------------------
# Compose reads these to create the PostgreSQL container and to build the
# orchestrator's DATABASE_URL. Empty gives authuser / authpass / authdb, which
# exist only on your machine. Set all three to use anything else.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# -------------------------------------------------------------
# 5. OUTSIDE THE DOCKER DEMO ONLY
# -------------------------------------------------------------
# ADMIN_PRIVATE_KEY signs the pause, resume and Merkle-root transactions. Empty
# uses the local Hardhat node's first unlocked account, which is the contract's
# admin. A real network has no unlocked account, so any real deployment must
# set this. Never commit a key that controls real funds.
ADMIN_PRIVATE_KEY=

# Pins the contract address instead of reading the one the deploy step wrote.
# Leave empty: a pinned address goes stale the moment the chain is reset, and
# every chain call then fails.
CONTRACT_ADDRESS=

# -------------------------------------------------------------
# 6. REFERENCE — supplied by Compose; setting them here does nothing
# -------------------------------------------------------------
# docker-compose.yml sets these on the containers, and a service's own
# environment always wins over this file:
#   DATABASE_URL           postgres://...@postgres:5432/...
#   MONGO_URL              mongodb://mongo:27017
#   RISK_ENGINE_URL        http://risk-engine:8001
#   ORCHESTRATOR_URL       http://orchestrator:3001
#   RPC_URL                http://hardhat:8545
#   CONTRACT_ADDRESS_FILE  /shared/contract-address.txt
#   VELOCITY_THRESHOLD     5, raised to 10 by docker-compose.dev.yml
#   VELOCITY_WINDOW_SECONDS 300
#   OTP_DEMO_DELIVERY      true, set only by docker-compose.dev.yml
#
# The seed and scenario scripts run on the host and do not read this file. They
# default to http://localhost:3001 and http://localhost:8001; to point them
# elsewhere, set the variable in your shell for that command, for example:
#   ORCHESTRATOR_URL=http://localhost:4001 npm run seed
